@@ -116,6 +118,37 @@ def get_model(cfg, signal):
 
         scheduler = torch.optim.lr_scheduler.StepLR(optim, step_size = 3000, gamma = 0.1)
 
+    elif cfg.net.model_name.startswith('sasnet'):
+        hp = cfg.net[cfg.net.model_name]
+        inr = SASNet(
+            in_features = cfg.net.in_features, out_features = signal.ch, hidden_features = hp.hidden_features, masked_hidden_layer_groups = hp.masked_hidden_layer_groups,
+            omega_0 = hp.omega_0, period = hp.period, bandlimit = hp.bandlimit, low_range = hp.low_range, perc_low_freqs = hp.perc_low_freqs,
+            num_high_freq_bands = hp.num_high_freq_bands, hash_grid = hp.hash_grid,
+            use_masks = hp.get('use_masks', True)
+        )
+
+        # use_masks = False drops the hash grid and mask decoder (plain FEmb + SIREN ablation).
+        mask_modules = [m for m in (inr.net.grid, inr.net.decoder) if m is not None]
+        mask_param_ids = {id(p) for m in mask_modules for p in m.parameters()}
+        backbone_params = [p for p in inr.net.parameters() if p.requires_grad and id(p) not in mask_param_ids]
+
+        param_groups = [{'params': backbone_params, 'lr': hp.lr}]
+        if mask_modules:
+            param_groups += [
+                {'params': inr.net.grid.parameters(), 'lr': hp.lr_grid},
+                {'params': inr.net.decoder.parameters(), 'lr': hp.lr_decoder}
+            ]
+        optim = torch.optim.Adam(param_groups, betas = tuple(hp.get('betas', (0.9, 0.999))))
+
+        # 'plateau' mirrors the FDHO schedule above; 'cosine' decays every group to 1% by the last step.
+        sched = hp.get('scheduler', 'none')
+        if sched == 'plateau':
+            scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optim, mode = 'min', factor = 0.1, patience = 500, threshold = 1e-4, min_lr = 1e-6)
+        elif sched == 'cosine':
+            scheduler = torch.optim.lr_scheduler.LambdaLR(optim, lambda x: 0.01 + 0.99 * 0.5 * (1 + math.cos(math.pi * min(x / cfg.train.steps, 1))))
+        elif sched != 'none':
+            raise ValueError(f"Unknown SASNet scheduler '{sched}'. Use 'none', 'plateau' or 'cosine'.")
+
     else:
         raise ValueError(f"Unknown model name '{cfg.net.model_name}'. Available: {ALL_MODELS}.")
 
